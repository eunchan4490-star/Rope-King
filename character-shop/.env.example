# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Bank account info shown on the order/checkout page. Never hardcode this in
# source — it is only ever read from this environment variable, server-side,
# and only rendered to a user who is logged in and has an order in progress.
DEPOSIT_BANK_NAME=우리은행
DEPOSIT_ACCOUNT_NUMBER=0000-000-000000
DEPOSIT_ACCOUNT_HOLDER=홍길동

# Optional: site URL used to build the OAuth redirect. Defaults to
# http://localhost:3000 in dev; set this to your Vercel deployment URL in
# production (e.g. https://your-app.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
